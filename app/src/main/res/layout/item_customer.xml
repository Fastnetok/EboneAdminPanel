<?xml version="1.0" encoding="utf-8"?>
<androidx.cardview.widget.CardView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginStart="6dp"
    android:layout_marginEnd="6dp"
    android:layout_marginBottom="4dp"
    app:cardCornerRadius="10dp"
    app:cardElevation="1dp"
    app:cardUseCompatPadding="false"
    app:cardBackgroundColor="@android:color/white">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="10dp"
        android:paddingTop="6dp"
        android:paddingEnd="6dp"
        android:paddingBottom="5dp">

        <!-- Line 1: Customer ID / Name -->
        <TextView
            android:id="@+id/tvCustomerId"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:ellipsize="end"
            android:maxLines="1"
            android:text="Abbasok"
            android:textColor="#172033"
            android:textSize="14sp"
            android:textStyle="bold" />

        <!-- Line 2: ISP -->
        <TextView
            android:id="@+id/tvPanel"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="1dp"
            android:maxLines="1"
            android:text="EBONE"
            android:textColor="#0D2E5C"
            android:textSize="9sp"
            android:textStyle="bold" />

        <!-- Line 3: EVERYTHING stays on ONE line -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="26dp"
            android:layout_marginTop="1dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <!-- Package + Price -->
            <TextView
                android:id="@+id/tvPackage"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:ellipsize="end"
                android:maxLines="1"
                android:gravity="center_vertical"
                android:text="8 Mbps · Rs 1500"
                android:textColor="#667085"
                android:textSize="10sp" />

            <!-- Active / Disabled — SAME LINE -->
            <TextView
                android:id="@+id/tvStatus"
                android:layout_width="wrap_content"
                android:layout_height="24dp"
                android:minWidth="64dp"
                android:gravity="center"
                android:paddingStart="7dp"
                android:paddingEnd="7dp"
                android:maxLines="1"
                android:ellipsize="end"
                android:background="@drawable/bg_status_bracket"
                android:text="Active"
                android:textColor="#18794E"
                android:textSize="10sp"
                android:textStyle="bold" />

            <!-- Edit — SAME LINE -->
            <ImageButton
                android:id="@+id/btnEdit"
                android:layout_width="30dp"
                android:layout_height="30dp"
                android:layout_marginStart="4dp"
                android:background="@drawable/bg_edit_button"
                android:contentDescription="Edit customer"
                android:padding="6dp"
                android:src="@drawable/ic_edit"
                app:tint="#344054" />

            <!-- Recycle Bin — SAME LINE, FAR RIGHT -->
            <ImageButton
                android:id="@+id/btnDelete"
                android:layout_width="30dp"
                android:layout_height="30dp"
                android:layout_marginStart="3dp"
                android:background="@drawable/bg_delete_button"
                android:contentDescription="Delete customer"
                android:padding="6dp"
                android:src="@drawable/ic_delete"
                app:tint="#C62828" />

        </LinearLayout>

    </LinearLayout>

</androidx.cardview.widget.CardView>
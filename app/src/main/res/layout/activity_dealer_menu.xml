<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fitsSystemWindows="true"
    android:fillViewport="true"
    android:background="#F4F6FA">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="18dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="64dp"
            android:background="#0D47A1"
            android:gravity="center_vertical"
            android:paddingStart="18dp"
            android:paddingEnd="12dp">

            <TextView
                android:id="@+id/menuBack"
                android:layout_width="48dp"
                android:layout_height="match_parent"
                android:gravity="center"
                android:text="‹"
                android:textColor="#FFFFFF"
                android:textSize="34sp" />

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:gravity="center"
                android:text="PAYMENT LIMIT SETTINGS"
                android:textColor="#FFFFFF"
                android:textSize="20sp"
                android:textStyle="bold" />

            <Space
                android:layout_width="48dp"
                android:layout_height="1dp" />

        </LinearLayout>

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="26dp"
            android:text="Minimum Payment Amount"
            android:textColor="#222222"
            android:textSize="17sp"
            android:textStyle="bold" />

        <EditText
            android:id="@+id/minimumPaymentInput"
            android:layout_width="match_parent"
            android:layout_height="55dp"
            android:layout_marginTop="7dp"
            android:backgroundTint="#0D47A1"
            android:hint="Enter minimum amount"
            android:inputType="number"
            android:paddingStart="12dp"
            android:paddingEnd="12dp"
            android:textColor="#222222"
            android:textSize="18sp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:text="Maximum Payment Amount"
            android:textColor="#222222"
            android:textSize="17sp"
            android:textStyle="bold" />

        <EditText
            android:id="@+id/maximumPaymentInput"
            android:layout_width="match_parent"
            android:layout_height="55dp"
            android:layout_marginTop="7dp"
            android:backgroundTint="#0D47A1"
            android:hint="Enter maximum amount"
            android:inputType="number"
            android:paddingStart="12dp"
            android:paddingEnd="12dp"
            android:textColor="#222222"
            android:textSize="18sp" />

        <TextView
            android:id="@+id/paymentLimitStatus"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="18dp"
            android:text="Saved: Rs. 3000 - Rs. 100000"
            android:textColor="#555555"
            android:textSize="15sp" />

        <Button
            android:id="@+id/savePaymentLimitsButton"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:layout_marginTop="22dp"
            android:text="SAVE PAYMENT LIMITS"
            android:textSize="16sp"
            android:textStyle="bold" />

    </LinearLayout>

</ScrollView>
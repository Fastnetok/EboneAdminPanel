<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:background="@drawable/bg_decent_card"
    android:padding="10dp"
    android:layout_marginTop="4dp"
    android:layout_marginBottom="4dp">

    <!-- Top Row: Name/ID and Status Badge -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical">

        <TextView
            android:id="@+id/tvComplaintTitle"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="Name / ID"
            android:textColor="#212121"
            android:textSize="14.5sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/tvComplaintStatus"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:background="#E8F5E9"
            android:paddingStart="8dp"
            android:paddingTop="2dp"
            android:paddingEnd="8dp"
            android:paddingBottom="2dp"
            android:text="Resolved"
            android:textColor="#2E7D32"
            android:textSize="12sp"
            android:textStyle="bold" />

    </LinearLayout>

    <!-- Address -->
    <TextView
        android:id="@+id/tvComplaintAddress"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:text="📍 Address: Street 12, Area Name"
        android:textColor="#37474F"
        android:textSize="13sp" />

    <!-- Phone Number (Clickable -> Dialer) -->
    <TextView
        android:id="@+id/tvComplaintPhone"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="3dp"
        android:text="📞 Phone: 03001234567 (Tap to Call)"
        android:textColor="#1B5E20"
        android:textSize="13sp"
        android:textStyle="bold"
        android:clickable="true"
        android:focusable="true"
        android:foreground="?attr/selectableItemBackground" />

    <!-- Date & Time + Employee Name -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:layout_marginTop="4dp">

        <TextView
            android:id="@+id/tvComplaintDate"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="📅 01/09/2024 10:30 AM"
            android:textColor="#546E7A"
            android:textSize="12sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/tvComplaintEmployee"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="🧑‍🔧 Kashif"
            android:textColor="#1565C0"
            android:textSize="12sp"
            android:textStyle="bold" />

    </LinearLayout>

</LinearLayout>

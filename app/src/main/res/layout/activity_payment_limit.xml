<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fitsSystemWindows="true"
    android:fillViewport="true"
    android:background="#FFFFFF">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="20dp"
        android:background="#FFFFFF">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="70dp"
            android:background="#0D47A1"
            android:gravity="center"
            android:text="PAYMENT LIMIT SETTINGS"
            android:textColor="#FFFFFF"
            android:textSize="21sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:text="Minimum Payment Amount"
            android:textColor="#222222"
            android:textSize="17sp"
            android:textStyle="bold" />

        <EditText
            android:id="@+id/minimumPaymentInput"
            android:layout_width="match_parent"
            android:layout_height="55dp"
            android:layout_marginTop="8dp"
            android:hint="e.g. 3000"
            android:inputType="number"
            android:paddingStart="14dp"
            android:paddingEnd="14dp"
            android:textSize="18sp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="22dp"
            android:text="Maximum Payment Amount"
            android:textColor="#222222"
            android:textSize="17sp"
            android:textStyle="bold" />

        <EditText
            android:id="@+id/maximumPaymentInput"
            android:layout_width="match_parent"
            android:layout_height="55dp"
            android:layout_marginTop="8dp"
            android:hint="e.g. 100000"
            android:inputType="number"
            android:paddingStart="14dp"
            android:paddingEnd="14dp"
            android:textSize="18sp" />

        <TextView
            android:id="@+id/paymentLimitStatus"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="18dp"
            android:text="Current limit: Rs. 3000 - Rs. 100000"
            android:textColor="#555555"
            android:textSize="15sp" />

        <Button
            android:id="@+id/savePaymentLimitsButton"
            android:layout_width="match_parent"
            android:layout_height="58dp"
            android:layout_marginTop="24dp"
            android:text="SAVE PAYMENT LIMITS"
            android:textSize="16sp"
            android:textStyle="bold" />

    </LinearLayout>

</ScrollView>
<?xml version="1.0" encoding="utf-8"?>

<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="#F5F5F5">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="95dp"
        android:background="#0D47A1"
        android:gravity="center_vertical"
        android:paddingTop="32dp"
        android:paddingStart="15dp"
        android:paddingEnd="15dp">

        <TextView
            android:id="@+id/menuButton"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="☰"
            android:textColor="#FFFFFF"
            android:textSize="26sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:paddingStart="15dp"
            android:text="EBONE ADMIN PANEL"
            android:textColor="#FFFFFF"
            android:textSize="22sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/notificationButton"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="🔔"
            android:textSize="22sp" />

    </LinearLayout>

    <!-- === CHAARON CARDS KA GRID + EK HI BADGE CIRCLE DARMIYAN MEIN === -->
    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <!-- ROW 1: TOTAL + PENDING -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:paddingTop="15dp"
                android:paddingStart="8dp"
                android:paddingEnd="8dp">

                <TextView
                    android:id="@+id/totalComplaintText"
                    android:layout_width="0dp"
                    android:layout_height="95dp"
                    android:layout_weight="1"
                    android:layout_margin="4dp"
                    android:background="#2962FF"
                    android:gravity="center"
                    android:text=""
                    android:textColor="#FFFFFF"
                    android:textSize="17sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/pendingComplaintText"
                    android:layout_width="0dp"
                    android:layout_height="95dp"
                    android:layout_weight="1"
                    android:layout_margin="4dp"
                    android:background="#E53935"
                    android:gravity="center"
                    android:text=""
                    android:textColor="#FFFFFF"
                    android:textSize="17sp"
                    android:textStyle="bold" />

            </LinearLayout>

            <!-- ROW 2: IN PROGRESS + RESOLVED -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:paddingStart="8dp"
                android:paddingEnd="8dp">

                <TextView
                    android:id="@+id/inProgressText"
                    android:layout_width="0dp"
                    android:layout_height="95dp"
                    android:layout_weight="1"
                    android:layout_margin="4dp"
                    android:background="#FB8C00"
                    android:gravity="center"
                    android:text=""
                    android:textColor="#FFFFFF"
                    android:textSize="17sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/resolvedText"
                    android:layout_width="0dp"
                    android:layout_height="95dp"
                    android:layout_weight="1"
                    android:layout_margin="4dp"
                    android:background="#43A047"
                    android:gravity="center"
                    android:text=""
                    android:textColor="#FFFFFF"
                    android:textSize="17sp"
                    android:textStyle="bold" />

            </LinearLayout>

        </LinearLayout>

        <!-- EK HI 12mm BADGE CIRCLE — CHAARON CARDS KE BEECH DARMIYAN MEIN -->
        <LinearLayout
            android:id="@+id/newConnectionBadge"
            android:layout_width="12mm"
            android:layout_height="12mm"
            android:layout_gravity="center"
            android:orientation="vertical"
            android:gravity="center"
            android:background="@drawable/bg_stat_badge_circle"
            android:visibility="gone">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1"
                android:gravity="center|bottom"
                android:includeFontPadding="false"
                android:text="NEW"
                android:textColor="#FFFFFF"
                android:textSize="16sp"
                android:textStyle="bold"
                android:autoSizeTextType="uniform"
                android:autoSizeMinTextSize="8sp"
                android:autoSizeMaxTextSize="16sp"
                android:autoSizeStepGranularity="1sp"
                android:maxLines="1" />

            <View
                android:layout_width="8mm"
                android:layout_height="0.4mm"
                android:background="#FFFFFF" />

            <TextView
                android:id="@+id/centerBadgeCountText"
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1"
                android:gravity="center|top"
                android:includeFontPadding="false"
                android:text="1"
                android:textColor="#FFFFFF"
                android:textSize="20sp"
                android:textStyle="bold" />

        </LinearLayout>

    </FrameLayout>
    <!-- === CARDS + BADGE BLOCK KHATAM === -->

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingStart="10dp"
        android:paddingEnd="8dp"
        android:paddingTop="4dp"
        android:paddingBottom="2dp">

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="LIVE TRACKING"
            android:textStyle="bold"
            android:textSize="20sp"
            android:textColor="#444444" />

        <TextView
            android:id="@+id/dealerPanelButton"
            android:layout_width="58dp"
            android:layout_height="54dp"
            android:gravity="center"
            android:paddingTop="2dp"
            android:paddingBottom="2dp"
            android:clickable="true"
            android:focusable="true"
            android:text="Dealer"
            android:textColor="#444444"
            android:textSize="13sp"
            android:textStyle="bold"
            android:drawableTop="@drawable/ic_dealer"
            android:drawablePadding="0dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="Dealer" />

        <TextView
            android:id="@+id/activeCustomersButton"
            android:layout_width="58dp"
            android:layout_height="54dp"
            android:layout_marginStart="4dp"
            android:gravity="center"
            android:paddingTop="2dp"
            android:paddingBottom="2dp"
            android:clickable="true"
            android:focusable="true"
            android:text="Active"
            android:textColor="#444444"
            android:textSize="13sp"
            android:textStyle="bold"
            android:drawableTop="@drawable/ic_active_customer"
            android:drawablePadding="0dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="Active" />

        <TextView
            android:id="@+id/shortcutComplaintButton"
            android:layout_width="58dp"
            android:layout_height="54dp"
            android:layout_marginStart="4dp"
            android:gravity="center"
            android:paddingTop="2dp"
            android:paddingBottom="2dp"
            android:clickable="true"
            android:focusable="true"
            android:text="Complaint"
            android:textColor="#E53935"
            android:textSize="13sp"
            android:textStyle="bold"
            android:drawableTop="@drawable/ic_users"
            android:drawableTint="#E53935"
            android:drawablePadding="0dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="Complaint" />

        <TextView
            android:id="@+id/shortcutNewConnButton"
            android:layout_width="58dp"
            android:layout_height="54dp"
            android:layout_marginStart="4dp"
            android:gravity="center"
            android:paddingTop="2dp"
            android:paddingBottom="2dp"
            android:clickable="true"
            android:focusable="true"
            android:text="NEW (0)"
            android:textColor="#1565C0"
            android:textSize="13sp"
            android:textStyle="bold"
            android:drawableTop="@drawable/ic_new_connection"
            android:drawablePadding="0dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="New Connection" />

    </LinearLayout>

    <fragment
        android:id="@+id/dashboardMap"
        android:name="com.google.android.gms.maps.SupportMapFragment"
        android:layout_width="match_parent"
        android:layout_height="460dp"
        android:layout_marginStart="8dp"
        android:layout_marginEnd="8dp" />

    <TextView
        android:id="@+id/onlineEmployeesText"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingStart="10dp"
        android:paddingTop="4dp"
        android:text="🟢 Online Employees (0)"
        android:textColor="#444444"
        android:textSize="18sp"
        android:textStyle="bold" />

    <TextView
        android:id="@+id/onlineEmployeesNames"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingStart="42dp"
        android:text=""
        android:textColor="#555555"
        android:textSize="17sp" />

    <TextView
        android:id="@+id/offlineEmployeesText"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingStart="10dp"
        android:paddingTop="4dp"
        android:text="🔴 Offline Employees (0)"
        android:textColor="#444444"
        android:textSize="18sp"
        android:textStyle="bold" />

    <TextView
        android:id="@+id/offlineEmployeesNames"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingStart="42dp"
        android:text=""
        android:textColor="#555555"
        android:textSize="17sp" />

</LinearLayout>